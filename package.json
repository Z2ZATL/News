    "eslint-config-next": "15.5.21",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-no-secrets": "2.3.3",
    "eslint-plugin-security": "^3.0.1",
    "lighthouse": "13.4.1",
    "tailwindcss": "^4",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0"
