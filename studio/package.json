{
  "name": "z2zs-lab-studio",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "author": "Aitthikorn Khammee and Z2Zs Lab",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Z2ZATL/News.git",
    "directory": "studio"
  },
  "bugs": {
    "url": "https://github.com/Z2ZATL/News/issues"
  },
  "homepage": "https://github.com/Z2ZATL/News/tree/main/studio#readme",
  "type": "module",
  "packageManager": "pnpm@11.16.0",
  "scripts": {
    "dev": "sanity dev",
    "build": "sanity build",
    "deploy": "sanity deploy",
    "lint": "eslint --max-warnings=0",
    "schema:extract": "sanity schema extract --enforce-required-fields --force --path schema.json",
    "typegen": "sanity schema extract --enforce-required-fields --force --path schema.json && sanity typegen generate",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@sanity/vision": "6.6.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sanity": "6.6.0",
    "styled-components": "6.1.19"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "24.10.1",
    "@types/react": "19.2.17",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-no-secrets": "2.3.3",
    "eslint-plugin-security": "3.0.1",
    "typescript-eslint": "8.65.0",
    "typescript": "5.9.3"
  },
  "optionalDependencies": {
    "@esbuild/win32-arm64": "0.28.1",
    "@rolldown/binding-win32-arm64-msvc": "1.1.5"
  }
}
