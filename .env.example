NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SITE_URL=http://localhost:3000
SANITY_API_READ_TOKEN=
PREVIEW_TICKET_SECRET=
SANITY_WEBHOOK_SECRET=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
REACTION_COOKIE_SECRET=
RATE_LIMIT_SECRET=
# Local tests may use `memory`. Production and deploy previews must use `redis`
# so reaction totals, rate limits, and one-time preview tickets are shared.
REACTION_STORE=memory
DEPLOY_ENV=development

# Use `sanity` on production and deploy previews. `fixture` is only for local
# development and CI.
CONTENT_SOURCE=fixture

# Local migration command only. Use an editor token and remove it after migration.
SANITY_MIGRATION_TOKEN=
